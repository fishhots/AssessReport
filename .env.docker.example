# Java 后端与 Python 智能体之间的内部认证密钥。
# 已生成随机值；如需更换，用 `openssl rand -hex 32` 重新生成。
ASSESS_SERVICE_TOKEN=82d6c5a49e8d556751f07749344e878583f050a5a8cd867e665e74245981b55b

# 绑定 0.0.0.0 以通过公网 IP 访问；访问网页需要注册并登录。
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8088

# 注册邀请码。HTTPS 部署时将 ASSESS_COOKIE_SECURE 设为 true。
ASSESS_INVITE_CODE=appmath
ASSESS_COOKIE_SECURE=false

# 下面保持默认即可；报告较复杂时可以再调整。
ASSESS_MODEL_TIMEOUT=90
ASSESS_RELAY_MODEL_TIMEOUT=600
ASSESS_RELAY_TEST_TIMEOUT=60
ASSESS_JOB_TIMEOUT=3600
ASSESS_MAX_MODEL_CALLS=120
ASSESS_ANALYSIS_OUTPUT_TOKENS=16000
ASSESS_MAX_OUTPUT_TOKENS=12000

# 联网搜索（DeepSeek 官方 Search / Fetch）。默认关闭；密钥也可在网页「模型设置」里配置 DeepSeek 后自动复用。
ASSESS_WEB_SEARCH_ENABLED=false
ASSESS_WEB_SEARCH_CACHE_DAYS=30
# ASSESS_WEB_SEARCH_API_KEY=
# ASSESS_WEB_SEARCH_BASE_URL=https://api.deepseek.com
