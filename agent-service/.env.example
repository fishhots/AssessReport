# 复制为 .env，仅配置服务运行参数。各模型信息在网页“模型设置”中填写。
ASSESS_HOST=127.0.0.1
ASSESS_PORT=8000
ASSESS_SERVICE_TOKEN=
# 默认读取 ../backend/data/uploads，数据保存在本目录 data/。
# ASSESS_UPLOAD_ROOT=C:/Documents/Agent/AssessReport/backend/data/uploads
ASSESS_MODEL_TIMEOUT=90
# 中转报告调用等待上限（秒）：涵盖分析、正文、修订；默认10分钟。
ASSESS_RELAY_MODEL_TIMEOUT=600
# 中转连接测试单次等待上限（秒），与长报告调用分别设置。
ASSESS_RELAY_TEST_TIMEOUT=60
ASSESS_JOB_TIMEOUT=3600
ASSESS_MAX_MODEL_CALLS=120
# 深度分析与结构化正文分别设置输出上限。
ASSESS_ANALYSIS_OUTPUT_TOKENS=16000
ASSESS_MAX_OUTPUT_TOKENS=12000
# 图表使用系统中文字体；无中文字体的服务器可显式指定字体文件。
# ASSESS_CHART_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# 联网搜索（DeepSeek 官方 Search / Fetch）。默认关闭，不改变既有报告流程。
# 密钥优先复用网页「模型设置」中已保存的 DeepSeek API Key；如需单独指定再填下面一项。
# ASSESS_WEB_SEARCH_API_KEY=
# ASSESS_WEB_SEARCH_BASE_URL=https://api.deepseek.com
ASSESS_WEB_SEARCH_ENABLED=false
ASSESS_WEB_SEARCH_TIMEOUT=20
# 归档命中缓存的有效天数；期内相同检索指令直接复用，不联网、不计费。
ASSESS_WEB_SEARCH_CACHE_DAYS=30
# 单次检索最多归档的网页数（硬上限），避免意外产生过多请求。
ASSESS_WEB_SEARCH_MAX_PAGES=12
# ASSESS_WEB_SEARCH_MAX_PAGE_CHARS=40000
